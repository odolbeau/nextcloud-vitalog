{
	"name": "vitalog",
	"version": "0.1.0",
	"private": true,
	"description": "Journal de rendez-vous médicaux pour Nextcloud",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"build": "vite --mode production build",
		"dev": "vite --mode development build --watch",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"l10n:check": "node scripts/l10n.mjs check",
		"l10n:build": "node scripts/l10n.mjs build",
		"e2e": "playwright test",
		"e2e:api": "playwright test --project=setup --project=api",
		"e2e:ui": "playwright test --project=setup --project=desktop --project=mobile"
	},
	"dependencies": {
		"@nextcloud/axios": "^2.6.0",
		"@nextcloud/dialogs": "^7.5.0",
		"@nextcloud/files": "^4.1.0",
		"@nextcloud/l10n": "^3.4.1",
		"@nextcloud/logger": "^3.0.3",
		"@nextcloud/router": "^3.2.0",
		"@nextcloud/vue": "^9.13.1",
		"pinia": "^4.1.0",
		"vue": "^3.5.44",
		"vue-material-design-icons": "^5.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@nextcloud/browserslist-config": "^3.1.2",
		"@nextcloud/eslint-config": "^9.0.1",
		"@nextcloud/vite-config": "^2.5.4",
		"@playwright/test": "^1.64.1",
		"eslint": "^10.13.0",
		"sass": "^1.80.0",
		"vite": "^7.3.6"
	},
	"browserslist": [
		"extends @nextcloud/browserslist-config"
	],
	"engines": {
		"node": ">=20"
	}
}

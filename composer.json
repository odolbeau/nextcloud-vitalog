{
	"name": "odolbeau/vitalog",
	"description": "Keep track of your medical appointments in Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"doctrine/dbal": "^3.8",
		"friendsofphp/php-cs-fixer": "^3.64",
		"nextcloud/ocp": "dev-stable34",
		"phpunit/phpunit": "^11.5",
		"sabre/dav": "4.7.0",
		"sabre/vobject": "^4.5",
		"vimeo/psalm": "^6.20"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Vitalog\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Vitalog\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2.27"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"test": "phpunit -c tests/phpunit.xml",
		"lint": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1"
	}
}
